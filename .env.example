# Copia este archivo como .env y ajusta los valores. Nunca subas .env a GitHub.

# development | production (en production SECRET_KEY y JWT_SECRET_KEY son obligatorias)
APP_ENV=development
FLASK_DEBUG=1

SECRET_KEY=cambia-esto
JWT_SECRET_KEY=cambia-esto-tambien

# Sin DATABASE_URL se usa SQLite local (instance/astroalert.db)
# DATABASE_URL=postgresql://usuario:clave@host:5432/astroalert

# Ubicación del observador
LAT=-0.18
LON=-78.47
ALT=2850
CITY=Quito
TZ_NAME=America/Guayaquil

# Dominios externos que pueden llamar a la API (separados por coma). Vacío = solo el mismo dominio.
CORS_ORIGINS=

# Clave gratuita en https://api.nasa.gov (DEMO_KEY funciona con un límite bajo)
NASA_API_KEY=DEMO_KEY

# Alertas por correo (opcionales)
ENABLE_SCHEDULER=false
SENDGRID_API_KEY=
EMAIL_FROM=
ISS_ALERTA_KM=1500
HORA_RESUMEN=17:30
